programa {
  funcao inicio() {
real maq1, maq2, maq3, media

escreva("Consumo da primeira máquina: ", maq1)
leia(maq1)

escreva("Consumo da segunda máquina: ", maq2)
leia(maq2)

escreva("Consumo da terceira máquina: ", maq3)
leia(maq3)

media= (maq1 + maq2 + maq3)/3

escreva("A média de consumo produzida entre as três máquinas é de: ", media, "kWh")


  }
}
