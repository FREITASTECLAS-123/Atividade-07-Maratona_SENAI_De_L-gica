programa {
  funcao inicio() {
real Sa, Sb

escreva("Digite o número de produção de peças setor A: ")
leia(Sa)

escreva("Digite o número de produção de peças setor B: ")
leia(Sb)

se(Sa>Sb)
escreva("A produção de peças do setor A é maior comparado à produção do setor B")
senao se (Sb>Sa)
escreva("A produção de peças do setor B é maior comparado à produção do setor A")

  }
}
