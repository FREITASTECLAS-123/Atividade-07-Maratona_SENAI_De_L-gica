programa {
  funcao inicio() {
real num1, num2, num3, media

escreva("Digite a nota do primeiro teste: ")
leia(num1)

escreva("Digite a nota do segundo teste: ")
leia(num2)

escreva("Digite a nota do terceiro teste: ")
leia(num3)

media=(num1 + num2 + num3)/3
  se(media >= 7){
  escreva("Selo: Operador de Ouro")
}senao{
escreva("Precisa de reciclagem")
}



  }
}
